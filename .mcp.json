{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx -y @upstash/context7-mcp@latest"
      ],
      "env": {}
    },
    "exa": {
      "type": "stdio",
